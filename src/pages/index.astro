---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const legalServiceSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LegalService",
  "name": "A1 Quality Paralegal",
  "description": "Family-owned legal document preparation service in Grants Pass, Oregon since 1995.",
  "url": "https://www.a1paralegal.com",
  "telephone": "+15414742260",
  "email": "a1qualitydocuments@gmail.com",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "327 NE 6th St #1",
    "addressLocality": "Grants Pass",
    "addressRegion": "OR",
    "postalCode": "97526",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 42.4393,
    "longitude": -123.3284
  },
  "areaServed": [
    { "@type": "City", "name": "Grants Pass" },
    { "@type": "City", "name": "Medford" },
    { "@type": "City", "name": "Ashland" },
    { "@type": "City", "name": "Rogue River" },
    { "@type": "AdministrativeArea", "name": "Josephine County" },
    { "@type": "AdministrativeArea", "name": "Jackson County" }
  ],
  "foundingDate": "1995",
  "priceRange": "$$",
  "hasMap": "https://maps.google.com/?q=327+NE+6th+St+%231,+Grants+Pass,+OR+97526"
});
---

<Layout
  title="Paralegal Services in Grants Pass, OR"
  description="Personal, in-office document preparation for Grants Pass (GP) families since 1995. Wills, trusts, power of attorney, and more. Call 541-474-2260."
  schema={legalServiceSchema}
>
  <section class="hero">
    <div class="hero__inner">
      <div class="hero__copy">
        <p class="hero__tagline">Helping You, Help Yourself</p>
        <p class="hero__since">Since 1995</p>
        <h1>Protect What Matters Most.</h1>
        <p>Family-owned in Grants Pass (GP), Oregon. We sit with you in person, walk through every document together, and make sure your family is protected — clearly, affordably, and with care.</p>
        <p>Not in Grants Pass? No problem — we work with clients anywhere in Oregon, bringing the same personal care and attention to every case.</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="#services">Our Services</a>
          <a class="btn btn--ghost" href={`${base}contact-us/`}>Book an Appointment</a>
        </div>
      </div>
      <div class="hero__card">
        <h2>Estate Planning</h2>
        <p>Oregon families with property over $200k may need more than just a will. We'll help you prepare the right documents for your situation.</p>
        <div class="hero__card-details">
          <p><strong>Wills &amp; Trusts</strong></p>
          <p><strong>Power of Attorney</strong></p>
          <p><strong>Deeds &amp; Transfers</strong></p>
        </div>
        <a class="btn btn--secondary" href={`${base}estate-planning/`}>View Estate Packages</a>
      </div>
    </div>
  </section>

  <section class="mission reveal delay-1">
    <div class="mission__inner">
      <div class="mission__copy">
        <h2>Why Families Choose Us</h2>
        <p>We listen to your words, hear your heart, and help you accomplish your wishes. Our goal isn't just to prepare documents — it's to make sure you leave our office confident that your family is taken care of.</p>
        <p>Family-owned and operated since 1995. Every client gets our full attention, plain language, and personal care from start to finish.</p>
      </div>
      <div class="mission__panel">
        <h3>Come Sit Down With Us</h3>
        <p>We meet with every client in person at our Grants Pass office — no online questionnaires, no waiting on emails. Just a real conversation at your pace.</p>
        <ul>
          <li>Personal in-office appointments</li>
          <li>Plain language — no legal jargon</li>
          <li>Questions welcome, always</li>
        </ul>
      </div>
    </div>
  </section>

  <section id="services" class="services reveal delay-1">
    <div class="services__inner">
      <div class="section-head">
        <h2>Document Services</h2>
        <p>We prepare legal documents to your direction — clearly, accurately, and at your pace.</p>
      </div>
      <div class="service-carousel">
        <button class="carousel-btn carousel-btn--prev" aria-label="Previous services" disabled>&#10094;</button>
        <div class="carousel-track-wrap">
          <div class="carousel-track">
            <div class="service-card">
              <span class="service-card__icon">Wills</span>
              <h3>Wills &amp; Trusts</h3>
              <p>Your wishes, clearly documented. A properly established trust may also help your family avoid the time and cost of probate court.</p>
              <a class="service-card__link" href={`${base}estate-planning/`}>Learn more</a>
            </div>
            <div class="service-card">
              <span class="service-card__icon">POA</span>
              <h3>Power of Attorney</h3>
              <p>Make sure someone you trust can act on your behalf — financially and medically — if you ever can't.</p>
              <a class="service-card__link" href={`${base}power-of-attorney/`}>Learn more</a>
            </div>
            <div class="service-card">
              <span class="service-card__icon">Deeds</span>
              <h3>Deeds &amp; Transfers</h3>
              <p>Transfer property to the right person, the right way. Prepared clearly and accurately for your peace of mind.</p>
              <a class="service-card__link" href={`${base}deeds-transfers/`}>Learn more</a>
            </div>
            <div class="service-card">
              <span class="service-card__icon">HCPOA</span>
              <h3>Healthcare POA &amp; Advanced Directives</h3>
              <p>Ensure your medical wishes are honored and someone you trust can make healthcare decisions on your behalf.</p>
              <a class="service-card__link" href={`${base}power-of-attorney/`}>Learn more</a>
            </div>
            <div class="service-card">
              <span class="service-card__icon">Adopt</span>
              <h3>Adoption</h3>
              <p>Document preparation for stepparent and family adoption proceedings in Oregon.</p>
              <a class="service-card__link" href={`${base}adoption/`}>Learn more</a>
            </div>
            <div class="service-card">
              <span class="service-card__icon">Probate</span>
              <h3>Probate</h3>
              <p>We prepare the documents needed to navigate the probate process clearly and accurately.</p>
              <a class="service-card__link" href={`${base}probate/`}>Learn more</a>
            </div>
            <div class="service-card">
              <span class="service-card__icon">Affidavit</span>
              <h3>Simple Estate Affidavits</h3>
              <p>For qualifying smaller estates, a simple affidavit may allow assets to transfer without full probate.</p>
              <a class="service-card__link" href={`${base}probate/`}>Learn more</a>
            </div>
            <div class="service-card">
              <span class="service-card__icon">LLC</span>
              <h3>LLC Formation</h3>
              <p>Articles of Organization, Operating Agreements, and Bank Account Resolutions — everything to get your LLC properly documented.</p>
              <a class="service-card__link" href={`${base}llc-formation/`}>Learn more</a>
            </div>
            <div class="service-card">
              <span class="service-card__icon">RE Sales</span>
              <h3>Real Estate Sales</h3>
              <p>Trust deeds and sales agreements prepared accurately to support your real estate transaction.</p>
              <a class="service-card__link" href={`${base}real-estate-sales/`}>Learn more</a>
            </div>
            <div class="service-card">
              <span class="service-card__icon">Updates</span>
              <h3>Estate Document Updates</h3>
              <p>Life changes. We help you update existing wills, trusts, and estate documents to reflect your current wishes.</p>
              <a class="service-card__link" href={`${base}estate-planning/`}>Learn more</a>
            </div>
          </div>
        </div>
        <button class="carousel-btn carousel-btn--next" aria-label="Next services">&#10095;</button>
      </div>
    </div>
  </section>

  <section class="testimonial reveal delay-2">
    <div class="testimonial__inner">
      <div class="testimonial-carousel" id="testimonial-carousel">
        <div class="testimonial-slide is-active">
          <p class="testimonial__quote">"Thank you for your help in completing my Trust and Will. We are grateful to work with you, you are so nice to be with. May our Lord bless you in all you do."</p>
          <p class="testimonial__name">— Peggy H.</p>
        </div>
        <div class="testimonial-slide">
          <p class="testimonial__quote">"Lara and son KC have been a blessing in my life. They have aided me to help myself in the confusing world of legalities. They are excellent at their job and truly care about their clients."</p>
          <p class="testimonial__name">— Bethany L.</p>
        </div>
        <div class="testimonial-slide">
          <p class="testimonial__quote">"Laura and her son are very professional, and get things done in a timely manner! Very pleased."</p>
          <p class="testimonial__name">— Kevin S.</p>
        </div>
        <div class="testimonial-slide">
          <p class="testimonial__quote">"Wow, what a great experience working with Lara and her team! They really went the extra mile for us, and we highly recommend them."</p>
          <p class="testimonial__name">— Joe &amp; Monique A.</p>
        </div>
        <div class="testimonial-slide">
          <p class="testimonial__quote">"Great service, friendly and professional."</p>
          <p class="testimonial__name">— Gina B.</p>
        </div>
        <div class="testimonial-slide">
          <p class="testimonial__quote">"Nice people, they do good work."</p>
          <p class="testimonial__name">— Coby B.</p>
        </div>
      </div>
      <div class="testimonial-dots" id="testimonial-dots">
        <button class="testimonial-dot is-active" aria-label="Review 1"></button>
        <button class="testimonial-dot" aria-label="Review 2"></button>
        <button class="testimonial-dot" aria-label="Review 3"></button>
        <button class="testimonial-dot" aria-label="Review 4"></button>
        <button class="testimonial-dot" aria-label="Review 5"></button>
        <button class="testimonial-dot" aria-label="Review 6"></button>
      </div>
    </div>
  </section>

  <section class="contact-cta reveal delay-2">
    <div class="contact-cta__inner">
      <div>
        <h2>Ready to Get Started?</h2>
        <ul class="contact-cta__list">
          <li>
            <strong>Address:</strong>
            <a
              href="https://maps.google.com/?q=327+NE+6th+St+%231,+Grants+Pass,+OR+97526"
              target="_blank"
              rel="noopener noreferrer"
            >327 NE 6th St #1, Grants Pass, OR 97526</a>
          </li>
          <li><strong>Phone:</strong> <a href="tel:+15414742260">541-474-2260</a></li>
          <li><strong>Email:</strong> <a href="mailto:a1qualitydocuments@gmail.com">a1qualitydocuments@gmail.com</a></li>
        </ul>
      </div>
      <div>
        <a class="btn btn--primary" href={`${base}contact-us/`}>Send Us a Message</a>
      </div>
    </div>
  </section>
<script>
  // Testimonial auto-rotate
  const tCarousel = document.getElementById('testimonial-carousel');
  const tDots = document.querySelectorAll<HTMLButtonElement>('#testimonial-dots .testimonial-dot');
  if (tCarousel && tDots.length) {
    const slides = tCarousel.querySelectorAll<HTMLElement>('.testimonial-slide');
    let current = 0;
    let timer: ReturnType<typeof setInterval>;

    function goTo(index: number) {
      slides[current].classList.remove('is-active');
      tDots[current].classList.remove('is-active');
      current = index;
      slides[current].classList.add('is-active');
      tDots[current].classList.add('is-active');
    }

    function next() { goTo((current + 1) % slides.length); }

    function start() { timer = setInterval(next, 5000); }
    function stop() { clearInterval(timer); }

    tDots.forEach((dot, i) => dot.addEventListener('click', () => { stop(); goTo(i); start(); }));
    tCarousel.addEventListener('mouseenter', stop);
    tCarousel.addEventListener('mouseleave', start);

    start();
  }

  // Service carousel
  const track = document.querySelector<HTMLElement>('.carousel-track');
  if (track) {
    const cards = Array.from(track.querySelectorAll<HTMLElement>('.service-card'));
    const prevBtn = document.querySelector<HTMLButtonElement>('.carousel-btn--prev');
    const nextBtn = document.querySelector<HTMLButtonElement>('.carousel-btn--next');
    let current = 0;

    function visibleCount(): number {
      if (window.innerWidth <= 720) return 1;
      if (window.innerWidth <= 960) return 2;
      return 3;
    }

    function update() {
      const cardWidth = cards[0].offsetWidth;
      const gap = 20;
      if (track) track.style.transform = `translateX(-${current * (cardWidth + gap)}px)`;
      if (prevBtn) prevBtn.disabled = current === 0;
      if (nextBtn) nextBtn.disabled = current >= cards.length - visibleCount();
    }

    prevBtn?.addEventListener('click', () => { if (current > 0) { current--; update(); } });
    nextBtn?.addEventListener('click', () => { if (current < cards.length - visibleCount()) { current++; update(); } });
    window.addEventListener('resize', () => {
      current = Math.min(current, cards.length - visibleCount());
      update();
    });

    update();
  }
</script>
</Layout>
