---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const serviceSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Estate Planning Document Preparation",
  "provider": { "@type": "LegalService", "name": "A1 Quality Paralegal" },
  "areaServed": [
    { "@type": "City", "name": "Grants Pass" },
    { "@type": "City", "name": "Medford" },
    { "@type": "AdministrativeArea", "name": "Josephine County" },
    { "@type": "AdministrativeArea", "name": "Jackson County" }
  ],
  "offers": [
    { "@type": "Offer", "name": "Essential Protection — Individual", "price": "750.00", "priceCurrency": "USD" },
    { "@type": "Offer", "name": "Essential Protection — Couple", "price": "1000.00", "priceCurrency": "USD" },
    { "@type": "Offer", "name": "Complete Legacy Plan — Individual", "price": "1500.00", "priceCurrency": "USD" },
    { "@type": "Offer", "name": "Complete Legacy Plan — Family", "price": "2000.00", "priceCurrency": "USD" }
  ]
});
---

<Layout
  title="Estate Planning"
  description="Protect your family with personal, in-office estate planning from A1 Quality Paralegal — serving Grants Pass and Southern Oregon since 1995."
  schema={serviceSchema}
>
  <section class="page-hero reveal">
    <div class="page-hero__inner">
      <h1>Protect Your Family. Make the Hard Moments Easier.</h1>
      <p>For over 30 years, A1 Quality Paralegal has helped Grants Pass families get their estate in order — with personal, in-office guidance every step of the way.</p>
    </div>
  </section>

  <section class="differentiator reveal">
    <div class="differentiator__inner">
      <div class="differentiator__content">
        <p class="differentiator__lead">Come sit down with us.</p>
        <p>Document preparation at your pace, in person, with someone you can talk to. Bring your questions, take your time, and leave knowing everything is taken care of.</p>
        <p>Not in Grants Pass? No problem — we work with clients anywhere in Oregon, bringing the same personal care and attention to every case.</p>
      </div>
      <a class="btn btn--primary" href={`${base}contact-us/`}>Book an Appointment</a>
    </div>
  </section>

  <section class="packages reveal delay-1">
    <div class="packages__inner">
      <h2>Estate Packages</h2>
      <p>Every package includes a personal in-office appointment. We walk with you through every document, answering your questions along the way.</p>
      <p class="packages__note">Personal, friendly document preparation — clear language, no surprises. We are not attorneys and do not provide legal advice. Should you require legal advice, please contact an attorney.</p>

      <div class="packages__probate-callout">
        <strong>Oregon families with property over $200k or cash assets over $75k —</strong> a will alone may not be enough. Oregon law requires estates above these thresholds to go through probate court, which can be costly and time-consuming for your family. A properly established and maintained trust may help your family avoid probate.
      </div>

      <h3 class="packages__subhead">Trust Packages — Full Estate Protection</h3>
      <div class="package-grid package-grid--2">
        <div class="package-card package-card--featured">
          <span class="package-card__badge">Complete Estate Plan</span>
          <h3>Complete Legacy Plan — Individual</h3>
          <ul>
            <li>Trustor's Certification &amp; Memorandum of Trust — your trust is properly documented and legally recognized</li>
            <li>Revocable Trust Agreement — your assets are protected and distributed exactly as you intend</li>
            <li>Pour Over Will — anything outside your trust is captured and directed to it</li>
            <li>Durable General Power of Attorney — your finances stay in trusted hands if you can't manage them</li>
            <li>Oregon Advanced Directive — your medical wishes are honored, no family guesswork</li>
            <li>Health Care Power of Attorney — someone you trust speaks for you when you can't</li>
          </ul>
          <p class="package-card__price">$1,500.00</p>
        </div>
        <div class="package-card package-card--featured">
          <span class="package-card__badge">Complete Estate Plan</span>
          <h3>Complete Legacy Plan — Family</h3>
          <p class="package-card__copies">Two copies of every document — one for each person. The Trust Agreement and Certificate of Trust are prepared as one shared document.</p>
          <ul>
            <li>Trustors' Certification &amp; Memorandum of Trust — your trust is properly documented and legally recognized</li>
            <li>Revocable Trust Agreement — your assets are protected and distributed exactly as you intend</li>
            <li>Pour Over Will — anything outside your trust is captured and directed to it</li>
            <li>Durable General Power of Attorney — your finances stay in trusted hands if you can't manage them</li>
            <li>Oregon Advanced Directive — your medical wishes are honored, no family guesswork</li>
            <li>Health Care Power of Attorney — someone you trust speaks for you when you can't</li>
          </ul>
          <p class="package-card__price">$2,000.00</p>
        </div>
      </div>

      <h3 class="packages__subhead">Will Packages — Essential Protection</h3>
      <div class="package-grid package-grid--2">
        <div class="package-card">
          <h3>Essential Protection — Individual</h3>
          <ul>
            <li>Last Will &amp; Testament — your wishes are clear, your assets go where you choose</li>
            <li>Durable General Power of Attorney — your finances stay in trusted hands if you can't manage them</li>
            <li>Oregon Advanced Directive — your medical wishes are honored, no family guesswork</li>
            <li>Health Care Power of Attorney — someone you trust speaks for you when you can't</li>
          </ul>
          <p class="package-card__price">$750.00</p>
        </div>
        <div class="package-card">
          <h3>Essential Protection — Couple</h3>
          <p class="package-card__copies">Two copies of every document — one for each person.</p>
          <ul>
            <li>Last Will &amp; Testament — your wishes are clear, your assets go where you choose</li>
            <li>Durable General Power of Attorney — your finances stay in trusted hands if you can't manage them</li>
            <li>Oregon Advanced Directive — your medical wishes are honored, no family guesswork</li>
            <li>Health Care Power of Attorney — someone you trust speaks for you when you can't</li>
          </ul>
          <p class="package-card__price">$1,000.00</p>
        </div>
      </div>

      <div class="packages__single">
        <h3>Individual Documents</h3>
        <div class="package-grid">
          <div class="package-card">
            <h4>Durable General Power of Attorney</h4>
            <p class="package-card__price">$250.00</p>
          </div>
          <div class="package-card">
            <h4>Health Care Power of Attorney</h4>
            <p class="package-card__price">$250.00</p>
          </div>
          <div class="package-card">
            <h4>Advance Directive</h4>
            <p class="package-card__price">$250.00</p>
          </div>
        </div>
      </div>

      <div class="packages__turnaround">
        <p><strong>Standard turnaround:</strong> approximately 3 weeks from your appointment.</p>
        <p><strong>Need it faster?</strong> Ask about our express service — documents in 1 week for an additional $500.</p>
      </div>

      <div class="packages__cta">
        <a class="btn btn--primary" href={`${base}contact-us/`}>Book an Appointment</a>
        <a class="btn btn--ghost" href={`${base}contact-us/`} style="margin-left: 12px;">Ask a Question</a>
        <p class="packages__guarantee">If there is ever an error in your documents due to our preparation, we will correct it at no charge.</p>
      </div>
    </div>
  </section>

  <section class="content reveal delay-1">
    <div class="content__inner">
      <h2>Already Have Documents? Keep Them Current.</h2>
      <p>Estate documents are not set-and-forget. Major life changes can mean your existing documents no longer reflect your wishes — and an outdated document can create confusion for your family at the worst possible time.</p>
      <h3>Common reasons to update</h3>
      <ul>
        <li>Marriage or divorce</li>
        <li>The birth or adoption of a child or grandchild</li>
        <li>The death of a named beneficiary, executor, or trustee</li>
        <li>A significant change in assets — buying or selling property, inheritance, retirement</li>
        <li>A change in who you want in charge</li>
        <li>A change in your personal wishes</li>
      </ul>
      <p>Bring your existing documents to your appointment and we'll review them together, discuss what has changed, and prepare updated documents that reflect where you are today.</p>
      <div style="margin-top: 24px;">
        <a class="btn btn--ghost" href={`${base}contact-us/`}>Book an Update Appointment</a>
      </div>
    </div>
  </section>

  <section class="estate-testimonials reveal delay-1">
    <div class="estate-testimonials__inner">
      <h2>What Our Clients Say</h2>
      <div class="estate-testimonials__grid">
        <blockquote class="estate-testimonial-card">
          <p>"I highly recommend A1 Quality Paralegal. My questions were answered with helpful information, which alleviated my legal concerns. Good customer service. Thank you, thank you A1 Quality Paralegal. I'll be needing your services again to help w/my will/living trust."</p>
          <footer>— Joan K.</footer>
        </blockquote>
        <blockquote class="estate-testimonial-card">
          <p>"My husband and I wanted a simple Will and Health Care Directives. We have no children so estate planning was basic. Lara and KC did an outstanding job, providing excellent documents in a timely manner at an affordable price. Thank you!"</p>
          <footer>— Sharon R.</footer>
        </blockquote>
      </div>
    </div>
  </section>

  <section class="assurance reveal delay-2">
    <div class="assurance__inner">
      <h2>Family Owned. Locally Trusted. In Person.</h2>
      <p>Family owned and operated since 1995 — and we've never moved to a screen. Every client who walks into our Grants Pass office gets our full attention, plain language, and documents they can trust.</p>
      <p class="assurance__inaction">Most families put this off for years. When something unexpected happens without documents in place, the state decides what happens next — not you. One appointment changes that.</p>
    </div>
  </section>
</Layout>
