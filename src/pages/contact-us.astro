---
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm';
---

<Layout
  title="Contact & Book an Appointment"
  description="Get in touch with A1 Quality Paralegal in Grants Pass, Oregon — send a message or book an appointment online. Call 541-474-2260."
>
  <section class="page-hero reveal">
    <div class="page-hero__inner">
      <h1>Get in Touch — We're Here to Help.</h1>
      <p>Have a question or ready to get started? Reach out however works best for you.</p>
        <p>Not in Grants Pass? No problem — we work with clients anywhere in Oregon, bringing the same personal care and attention to every case.</p>
    </div>
  </section>

  <section class="booking-paths reveal">
    <div class="booking-paths__inner">
      <div class="booking-path-card">
        <span class="booking-path-card__icon">In Person</span>
        <h3>Come Sit Down With Us</h3>
        <p>Our most personal option. Visit our Grants Pass office and we'll walk through everything together at your pace — documents, questions, and all.</p>
      </div>
      <div class="booking-path-card">
        <span class="booking-path-card__icon">By Phone</span>
        <h3>Phone Consultation</h3>
        <p>Not sure what you need yet? A quick phone call is a great place to start. We'll help you figure out the right documents for your situation.</p>
      </div>
      <div class="booking-path-card">
        <span class="booking-path-card__icon">Online</span>
        <h3>Online Intake</h3>
        <p>Already know what you need and want to move fast? We can send you an intake form to complete on your own time and get your work moving sooner.</p>
      </div>
    </div>
  </section>

  <section class="contact-page reveal delay-1">
    <div class="contact-page__inner">
      <div class="contact-page__details">
        <h2>Contact Details</h2>
        <p>
          <a
            href="https://maps.google.com/?q=327+NE+6th+St+%231,+Grants+Pass,+OR+97526"
            target="_blank"
            rel="noopener noreferrer"
          >327 NE 6th St #1,<br />Grants Pass, OR 97526</a>
        </p>
        <p><a href="tel:+15414742260">Call or Text: 541-474-2260</a></p>
        <p class="booking__info-note">Our office is run by a small dedicated team — if you reach voicemail, leave a message and we'll get back to you promptly.</p>
        <p><a href="mailto:a1qualitydocuments@gmail.com">a1qualitydocuments@gmail.com</a></p>
        <div class="contact-page__map">
          <iframe
            title="A1 Quality Paralegal Map"
            src="https://www.google.com/maps?q=327%20NE%206th%20St%20%231,%20Grants%20Pass,%20OR%2097526&output=embed"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>

      <div class="contact-page__form">
        <h2>Send a Message</h2>
        <ContactForm client:load />
      </div>
    </div>
  </section>

  <section class="booking reveal delay-1">
    <div class="booking__inner">
      <div class="booking__info">
        <h2>Book an Appointment</h2>
        <ul>
          <li>Book a time using the calendar or give us a call — whichever feels right.</li>
          <li>We confirm your appointment and let you know what to bring.</li>
          <li>Meet us in person, by phone, or complete an online intake at your pace.</li>
          <li>We prepare your documents and review everything with you before you leave.</li>
        </ul>

        <h3>What to Have Ready</h3>
        <ul>
          <li>A list of your assets — real property, financial accounts, valuables</li>
          <li>The people you want in charge — executor, trustee, power of attorney holder, or healthcare agent — and their contact information</li>
          <li>Any existing estate documents you'd like us to review or update</li>
        </ul>
        <p class="booking__info-note">No need to look up deed information — we pull Oregon property records for you. Your Social Security Number is handled securely in the office at the end of your appointment, never collected beforehand.</p>
        <p style="margin-top: 16px;"><strong>Need it in a week?</strong> Ask about our express service when you book — available for an additional $500.</p>
      </div>
      <div class="booking__form">
        <h3>Request a Time</h3>
        <p>Use the calendar below to schedule your appointment.</p>
        <div class="booking__embed">
          <iframe
            src="https://calendar.google.com/calendar/appointments/AcZssZ0yhqmSu5PLaG2up8ZsB_KFKc-AS1YFYnLpmUs?gv=true"
            style="border: 0"
            width="100%"
            height="600"
            title="A1 Quality Paralegal Appointment Scheduling"
            loading="lazy"
          ></iframe>
          <p>
            Calendar not loading?
            <a
              href="https://calendar.google.com/calendar/appointments/AcZssZ0yhqmSu5PLaG2up8ZsB_KFKc-AS1YFYnLpmUs?gv=true"
              target="_blank"
              rel="noopener noreferrer"
            >Open it directly</a>.
          </p>
        </div>
      </div>
    </div>
  </section>
</Layout>
